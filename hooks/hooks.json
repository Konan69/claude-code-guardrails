{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/oss/claude-code-guardrails/hooks/now.sh\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/oss/claude-code-guardrails/hooks/short-reply.py\" remind"
          },
          {
            "type": "command",
            "command": "SKILL_ROUTER_ASYNC=1 python3 \"$HOME/oss/claude-code-guardrails/hooks/skill-router.py\"",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/oss/claude-code-guardrails/hooks/short-reply.py\" check"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"$HOME/oss/claude-code-guardrails/hooks/guarding.py\" || printf '%s\\n' 'u17 guarding launcher failed open' >&2",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Bash|mcp__t3-code__.*|mcp__t3_code__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/oss/claude-code-guardrails/hooks/rules-guard.py\" || { echo \"rules-guard crashed; refusing until it is fixed (python3 $HOME/oss/claude-code-guardrails/hooks/rules-guard-test.py)\" >&2; exit 2; }",
            "timeout": 40
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/oss/claude-code-guardrails/hooks/skill-gate.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json,os,re,sys;d=json.load(sys.stdin);s=re.sub(r'[^\\\\w-]','',str(d.get('session_id','')));p=os.path.expanduser('~/.claude/state/skill-loaded/'+s);s and os.path.exists(p) and os.unlink(p)\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
